{
  "$schema": "https://design-tokens.org/draft",
  "$description": "Portion design token draft. Mirrors the Figma variable collection 'Portion / Core' on the Branding / Stylescape page. This is a draft for the Design System phase — it does not assert that a production design system has been implemented.",
  "$version": "0.1.0",
  "$generated": "2026-09-02",
  "color": {
    "bg": {
      "canvas": { "$type": "color", "$value": "#FFFFFF" },
      "surface": { "$type": "color", "$value": "#F7F8FA" },
      "sunken": { "$type": "color", "$value": "#F2F4F7" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#17212B" },
      "secondary": { "$type": "color", "$value": "#52606D" },
      "onAction": { "$type": "color", "$value": "#FFFFFF" }
    },
    "border": {
      "control": {
        "$type": "color",
        "$value": "#77818B",
        "$description": "3.96:1 on canvas. Use wherever a boundary must be perceivable."
      },
      "decorative": {
        "$type": "color",
        "$value": "#E4E8EC",
        "$description": "1.23:1 on canvas. Decoration only — must never be the sole carrier of a boundary or meaning."
      }
    },
    "action": {
      "primary": { "$type": "color", "$value": "#2855D9" },
      "hover": { "$type": "color", "$value": "#2147B6" },
      "pressed": { "$type": "color", "$value": "#19368F" },
      "surfaceSelected": { "$type": "color", "$value": "#EAF0FF" }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "#19368F" },
      "gap": { "$type": "color", "$value": "#FFFFFF" }
    },
    "state": {
      "disabled": {
        "surface": { "$type": "color", "$value": "#E5E7EB" },
        "text": { "$type": "color", "$value": "#59636E" }
      }
    },
    "scrim": {
      "base": { "$type": "color", "$value": "#17212B" },
      "opacity": { "$type": "number", "$value": 0.4 }
    },
    "status": {
      "$description": "System conditions, never food quality. Never aliased to nutrition tokens.",
      "error": {
        "text": { "$type": "color", "$value": "#B42318" },
        "surface": { "$type": "color", "$value": "#FFF1F0" }
      },
      "warning": {
        "text": { "$type": "color", "$value": "#8A4B0C" },
        "surface": { "$type": "color", "$value": "#FFF5E7" }
      },
      "success": {
        "text": { "$type": "color", "$value": "#166534" },
        "surface": { "$type": "color", "$value": "#EFF8F1" }
      },
      "info": {
        "text": { "$type": "color", "$value": "#2147B6" },
        "surface": { "$type": "color", "$value": "#EAF0FF" },
        "$description": "Shares the action hue deliberately but is a separate token and is never rendered as an interactive control."
      }
    },
    "data": {
      "$description": "Nutrition category markers. Recognition aids only — never scores, never health verdicts, never aliased to status tokens.",
      "energy": {
        "accent": { "$type": "color", "$value": "#17212B" },
        "surface": { "$type": "color", "$value": "#F2F4F7" }
      },
      "protein": {
        "accent": { "$type": "color", "$value": "#7252A3" },
        "surface": { "$type": "color", "$value": "#F3EFF9" }
      },
      "carbohydrates": {
        "accent": { "$type": "color", "$value": "#087682" },
        "surface": { "$type": "color", "$value": "#EAF6F7" }
      },
      "fat": {
        "accent": { "$type": "color", "$value": "#955A0C" },
        "surface": { "$type": "color", "$value": "#FFF4E2" }
      },
      "fiber": {
        "accent": { "$type": "color", "$value": "#4E7029" },
        "surface": { "$type": "color", "$value": "#F1F5E8" }
      },
      "vitamins": {
        "accent": { "$type": "color", "$value": "#A04574" },
        "surface": { "$type": "color", "$value": "#F9EEF3" }
      },
      "minerals": {
        "accent": { "$type": "color", "$value": "#6B6259" },
        "surface": { "$type": "color", "$value": "#F3F0ED" }
      }
    }
  },
  "radius": {
    "structure": { "$type": "dimension", "$value": "0px" },
    "control": { "$type": "dimension", "$value": "4px" },
    "card": { "$type": "dimension", "$value": "8px" },
    "sheet": { "$type": "dimension", "$value": "12px" }
  },
  "space": {
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "48": { "$type": "dimension", "$value": "48px" },
    "64": { "$type": "dimension", "$value": "64px" }
  },
  "size": {
    "icon": { "$type": "dimension", "$value": "24px" },
    "target": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Portion's preferred control target. A product decision, not a WCAG requirement — WCAG 2.2 AA sets a 24x24 CSS px minimum with exceptions. CSS px, iOS pt and Android dp are not interchangeable."
    }
  },
  "elevation": {
    "sheet": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "-2px",
        "blur": "24px",
        "spread": "0px",
        "color": "rgba(23, 33, 43, 0.16)"
      },
      "$description": "The only overlay elevation. Ordinary surfaces use borders and space."
    }
  },
  "font": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": ["Inter", "system-ui", "sans-serif"]
      }
    },
    "feature": {
      "tabularNumbers": {
        "$type": "string",
        "$value": "\"tnum\" 1",
        "$description": "Implementation requirement. Could not be enabled through the Figma plugin API (openTypeFeatures is read-only), so it is specified rather than demonstrated in the design file. Apply wherever values align in a column or update in place."
      }
    },
    "style": {
      "screenHeading": { "$type": "typography", "$value": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 600 } },
      "mainResult": { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": 600 } },
      "cardTitle": { "$type": "typography", "$value": { "fontSize": "18px", "lineHeight": "26px", "fontWeight": 600 } },
      "body": { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 } },
      "action": { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 600 } },
      "label": { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 500 } },
      "support": { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 } },
      "wordmark": {
        "$type": "typography",
        "$value": { "fontSize": "40px", "lineHeight": "44px", "fontWeight": 600, "letterSpacing": "-3%", "textTransform": "lowercase" },
        "$description": "Wordmark only. Negative tracking must not be applied to interface text."
      }
    }
  },
  "icon": {
    "library": { "$type": "string", "$value": "phosphor-icons" },
    "weightDefault": { "$type": "string", "$value": "regular" },
    "weightSelected": {
      "$type": "string",
      "$value": "bold",
      "$description": "Persistent selected states only, such as the current navigation destination. Phosphor publishes thin, light, regular, bold, fill and duotone — there is no medium weight."
    }
  }
}
